* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: Inter, 'Segoe UI', sans-serif;
  background: #020817;
  color: #e2e8f0;
}

body {
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.9);
  color: #e2e8f0;
  padding: 0.7rem 0.9rem;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
  border-color: rgba(94, 234, 212, 0.7);
}

button.active {
  background: rgba(45, 212, 191, 0.18);
  border-color: rgba(45, 212, 191, 0.9);
  box-shadow: 0 0 0 1px rgba(45, 212, 191, 0.35);
}

input {
  width: 100%;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.22);
  color: #f8fafc;
  padding: 0.72rem 0.8rem;
}

.app-shell {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr) 320px;
  gap: 1rem;
  height: 100vh;
  padding: 1rem;
  background: linear-gradient(160deg, #020817 0%, #0f172a 100%);
}

.side-panel,
.center-panel {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 22px;
  box-shadow: 0 18px 40px rgba(2, 6, 23, 0.4);
}

.side-panel {
  padding: 1rem;
  overflow: auto;
}

.center-panel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1rem;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.8rem;
}

.panel-header h3 {
  margin: 0.1rem 0 0;
  font-size: 1.2rem;
}

.eyebrow {
  display: block;
  text-transform: uppercase;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  color: #94a3b8;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  background: rgba(15, 23, 42, 0.65);
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  padding: 0.8rem 0.9rem;
}

.tool-group {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.right-actions {
  margin-left: auto;
}

.field-capture {
  position: relative;
  overflow: hidden;
  border-radius: 22px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  min-height: 700px;
  background: linear-gradient(180deg, rgba(13, 37, 42, 0.6), rgba(8, 31, 27, 0.82));
  box-shadow: inset 0 0 60px rgba(2, 6, 23, 0.5);
}

.field-inner {
  position: absolute;
  inset: 0;
  border-radius: 22px;
  transform-origin: center;
  transition: transform 0.12s ease;
}

.field-graphic {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.player-marker {
  position: absolute;
  width: 3.2rem;
  height: 3.2rem;
  transform: translate(-50%, -50%);
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 1.1rem;
  color: #f8fafc;
  border: 3px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 16px 26px rgba(15, 23, 42, 0.35);
  user-select: none;
  touch-action: none;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.player-marker:hover {
  transform: translate(-50%, -50%) scale(1.04);
}

.player-marker.selected {
  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.05), 0 20px 36px rgba(15, 23, 42, 0.45);
}

.team-a {
  background: linear-gradient(180deg, #2dd4bf, #0f766e);
}

.team-b {
  background: linear-gradient(180deg, #fbbf24, #d97706);
}

.drawing-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.annotation-tag {
  position: absolute;
  transform: translate(-50%, -50%);
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.4);
  color: #f8fafc;
  border-radius: 999px;
  padding: 0.36rem 0.7rem;
  font-size: 0.72rem;
  max-width: 140px;
  text-align: center;
}

.roster-panel,
.scenario-panel {
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 18px;
  padding: 0.9rem;
}

.upload-row {
  margin: 0.7rem 0;
}

.manual-entry {
  display: grid;
  gap: 0.5rem;
  margin-bottom: 0.8rem;
}

.roster-list,
.scenario-list {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.roster-item {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  width: 100%;
  justify-content: flex-start;
  text-align: left;
  background: rgba(15, 23, 42, 0.7);
}

.roster-item.active {
  border-color: rgba(45, 212, 191, 0.65);
  background: rgba(20, 184, 166, 0.12);
}

.player-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.2rem;
  height: 2.2rem;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.18);
  font-weight: 700;
}

.player-name {
  flex: 1;
  font-weight: 600;
}

.player-role {
  color: #94a3b8;
  font-size: 0.78rem;
}

.ghost-button {
  background: rgba(148, 163, 184, 0.08);
}

.analysis-summary {
  display: grid;
  grid-template-columns: repeat(6, minmax(120px, 1fr));
  gap: 0.75rem;
  margin-top: auto;
}

.metric-card {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 16px;
  padding: 0.8rem 0.9rem;
}

.metric-card span {
  color: #94a3b8;
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.metric-card strong {
  font-size: 1rem;
  font-weight: 700;
}

.scenario-controls {
  display: grid;
  gap: 0.55rem;
  margin-bottom: 0.75rem;
}

.scenario-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.7rem 0.85rem;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(15, 23, 42, 0.62);
}

.scenario-item > div {
  display: flex;
  gap: 0.45rem;
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 1fr;
    height: auto;
  }

  .side-panel {
    max-height: none;
  }

  .analysis-summary {
    grid-template-columns: repeat(2, minmax(120px, 1fr));
  }
}

@media (max-width: 680px) {
  .app-shell {
    padding: 0.75rem;
  }

  .toolbar {
    justify-content: center;
  }

  .field-capture {
    min-height: 520px;
  }

  .analysis-summary {
    grid-template-columns: 1fr;
  }
}

@media (pointer: coarse) {
  .player-marker {
    width: 2.8rem;
    height: 2.8rem;
    font-size: 1rem;
  }
}

